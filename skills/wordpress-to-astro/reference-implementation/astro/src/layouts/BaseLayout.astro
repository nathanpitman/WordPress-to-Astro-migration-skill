---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TailScripts from '../components/TailScripts.astro';
import { chrome, type PageRecord } from '../lib/data';
interface Props { page: PageRecord; main: string }
const { page, main } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <Head page={page} />
  </head>

  <body class={page.bodyClass}>
    <Fragment set:html={chrome.pre} />
    <Header page={page} />
    <Fragment set:html={chrome.mid} />
    <Fragment set:html={main} />
    <Fragment set:html={chrome.post} />
    <Footer page={page} />
    <TailScripts page={page} />
  </body>
</html>
