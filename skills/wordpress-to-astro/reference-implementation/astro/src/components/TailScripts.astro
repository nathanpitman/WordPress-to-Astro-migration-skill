---
// Everything after the footer, as an ordered list per page: closing wrappers, popups, cookie banners,
// analytics and the theme/plugin script bundles.
import { tailRegistry, hasSearchScript, type PageRecord } from '../lib/data';
interface Props { page: PageRecord }
const { page } = Astro.props;
---
{page.tail.map((e) =>
  typeof e === 'string' ? <Fragment set:html={tailRegistry[e]} /> : <Fragment set:html={e.raw} />
)}
{hasSearchScript && <Fragment set:html={'<!-- Static-host search/filter script: see public/js/site-search.js -->\n<script src="/js/site-search.js" defer></script>'} />}
