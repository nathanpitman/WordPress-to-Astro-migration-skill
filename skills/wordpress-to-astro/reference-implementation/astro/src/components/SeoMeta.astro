---
// Yoast SEO block: robots, title, description, canonical, Open Graph, Twitter and the schema graph.
// Rendered in the same order and with the same quoting as the WordPress output.
import type { SeoItem } from '../lib/data';
interface Props { items: SeoItem[] }
const { items } = Astro.props;
const render = (it: SeoItem): string => {
  switch (it[0]) {
    case 'robots': return `<meta name='robots' content='${it[1]}' />`;
    case 'title': return `<title>${it[1]}</title>`;
    case 'description': return `<meta name="description" content="${it[1]}" />`;
    case 'canonical': return `<link rel="canonical" href="${it[1]}" />`;
    case 'property': return `<meta property="${it[1]}" content="${it[2]}" />`;
    case 'name': return `<meta name="${it[1]}" content="${it[2]}" />`;
    default: return it[1]; // comments and the JSON-LD graph are carried verbatim
  }
};
---
<Fragment set:html={items.map(render).join('\n')} />
