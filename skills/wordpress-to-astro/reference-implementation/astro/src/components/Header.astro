---
// Site header and primary navigation (verbatim). Per-page differences are nav "current item" classes,
// stored as line patches on the page record, plus the path inside the Livewire search snapshot.
import { chrome, applyPatches, livewirePath, type PageRecord } from '../lib/data';
interface Props { page: PageRecord }
const { page } = Astro.props;
const html = applyPatches(chrome.headerBase, page.headerPatches).replaceAll('{{LW_PATH}}', livewirePath(page.path));
---
<Fragment set:html={html} />
